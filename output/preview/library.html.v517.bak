<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>世界 · 灵境 · 双生</title>
<meta name="description" content="v6.4 · 第一卷·灵界万象 · 30 题材全分类 · 我的故事 · 官方库 · 玩家创作" />
<meta name="theme-color" content="#1A1A2E" />
<link rel="stylesheet" href="css/shell-v64.css" />
<style>
/* ---------- 搜索框 ---------- */
.search{
  display:flex;align-items:center;gap:10px;
  margin:14px var(--margin) 0;
  padding:12px 16px;border-radius:var(--radius);
  background:var(--card);border:1px solid var(--line);
}
.search input{flex:1;background:none;border:0;outline:0;color:var(--text);font-size:15px}
.search input::placeholder{color:rgba(160,160,176,.55)}
.search .ico{color:var(--sub)}

/* ---------- 分类 chips ---------- */
.chips{display:flex;gap:8px;overflow-x:auto;padding:14px var(--margin) 4px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{
  flex-shrink:0;padding:7px 14px;border-radius:999px;font-size:13px;
  background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--sub);
  transition:all .15s;
}
.chip.active{background:rgba(233,69,96,.15);border-color:rgba(233,69,96,.4);color:var(--accent);font-weight:600}

/* ---------- 数据概览 4 卡 ---------- */
.stats{
  display:grid;grid-template-columns:repeat(4,1fr);gap:8px;
  margin:14px var(--margin) 0;
}
.stat{
  padding:10px 6px;border-radius:10px;text-align:center;
  background:var(--card);border:1px solid var(--line);
}
.stat .v{font-size:20px;font-weight:600;font-family:-apple-system,BlinkMacSystemFont,serif}
.stat .l{font-size:10px;color:var(--sub);margin-top:2px}
.stat .v.c1{color:var(--world)}
.stat .v.c2{color:var(--accent)}
.stat .v.c3{color:var(--xinyu)}
.stat .v.c4{color:var(--warn)}

/* ---------- 我的故事 列表卡 ---------- */
.story-list{margin:0 var(--margin);display:flex;flex-direction:column;gap:10px}
.story{
  display:flex;gap:12px;align-items:center;padding:12px;border-radius:var(--radius);
  background:var(--card);border:1px solid var(--line);
  transition:transform .2s cubic-bezier(.16,1,.3,1);
}
.story:active{transform:scale(.98)}
.story .cov{
  width:54px;height:70px;border-radius:8px;flex-shrink:0;
  display:grid;place-items:center;font-size:24px;
}
.story .body{flex:1;min-width:0}
.story .t{font-size:15px;font-weight:600;line-height:1.3}
.story .s{font-size:12px;color:var(--sub);margin-top:3px}
.story .meta{display:flex;gap:10px;font-size:11px;color:rgba(160,160,176,.7);margin-top:5px;align-items:center}
.story .meta .star{color:var(--warn)}
.story .meta .play{color:var(--world);margin-left:auto}

/* ---------- 进度条 ---------- */
.pb{margin-top:6px;height:4px;border-radius:2px;background:rgba(255,255,255,.08);overflow:hidden}
.pb>div{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--accent),var(--warn))}

/* ---------- 跳转完整版链接 ---------- */
.more-link{
  display:block;margin:18px var(--margin) 0;text-align:center;
  font-size:12px;color:var(--sub);padding:10px;
  border:1px dashed var(--line);border-radius:10px;
}
</style>
</head>
<body>

<div id="app">

  <!-- 顶栏（v6.4 共享壳） -->
  <header class="topbar">
    <div class="topbar-title"><span class="dot"></span>世界</div>
    <div class="topbar-acts">
      <button class="icon-btn" onclick="showToast('ok','搜索已就绪','试试搜三国 / 林黛玉')" title="搜索">🔍</button>
      <a class="icon-btn" href="novel-upload.html" title="上传">📤</a>
      <button class="icon-btn" onclick="showToast('warn','3 条未读通知','通知中心即将开放')">🔔<span class="badge">3</span></button>
      <a class="icon-btn" href="me.html" title="我的">👤</a>
    </div>
  </header>

  <main>
    <!-- 搜索框 -->
    <div class="search">
      <span class="ico">🔍</span>
      <input type="search" placeholder="搜题材 / 小说 / 角色" id="search-input" oninput="filterStories(this.value)" />
    </div>

    <!-- 分类 chips -->
    <div class="chips" id="chips">
      <div class="chip active" data-cat="all">全部</div>
      <div class="chip" data-cat="古风">古风</div>
      <div class="chip" data-cat="都市">都市</div>
      <div class="chip" data-cat="悬疑">悬疑</div>
      <div class="chip" data-cat="仙侠">仙侠</div>
      <div class="chip" data-cat="科幻">科幻</div>
      <div class="chip" data-cat="恋爱">恋爱</div>
      <div class="chip" data-cat="玄幻">玄幻</div>
      <div class="chip" data-cat="校园">校园</div>
      <div class="chip" data-cat="武侠">武侠</div>
    </div>

    <!-- 数据概览 -->
    <div class="stats">
      <div class="stat"><div class="v c1">30</div><div class="l">题材</div></div>
      <div class="stat"><div class="v c2">6</div><div class="l">我的故事</div></div>
      <div class="stat"><div class="v c3">128</div><div class="l">可探索</div></div>
      <div class="stat"><div class="v c4">12</div><div class="l">结局</div></div>
    </div>

    <!-- 我的故事（进行中） -->
    <h2 class="sec">我的故事 <a class="more" href="me.html#play">查看全部</a></h2>
    <div class="story-list" id="my-stories">
      <a class="story" href="plot-runner.html?novelId=changye">
        <div class="cov" style="background:linear-gradient(160deg,#2E3A6E,#4A3A8C)">🏯</div>
        <div class="body">
          <div class="t">《长夜城》</div>
          <div class="s">第3章 · 初入长夜城</div>
          <div class="pb"><div style="width:45%"></div></div>
          <div class="meta"><span>45%</span><span class="play">继续 →</span></div>
        </div>
      </a>
      <a class="story" href="plot-runner.html?novelId=jinxiu">
        <div class="cov" style="background:linear-gradient(160deg,#5E2E3A,#E94560)">🌸</div>
        <div class="body">
          <div class="t">《锦绣未央》</div>
          <div class="s">第3章 · 雨夜抉择</div>
          <div class="pb"><div style="width:35%;background:linear-gradient(90deg,#E94560,#FFB347)"></div></div>
          <div class="meta"><span>35%</span><span class="play">继续 →</span></div>
        </div>
      </a>
      <a class="story" href="plot-runner.html?novelId=saibo">
        <div class="cov" style="background:linear-gradient(160deg,#2E5E56,#00B894)">🤖</div>
        <div class="body">
          <div class="t">《赛博长夜》</div>
          <div class="s">共通线 · 5/20</div>
          <div class="pb"><div style="width:25%;background:linear-gradient(90deg,#00B894,#4ECCA3)"></div></div>
          <div class="meta"><span>25%</span><span class="play">继续 →</span></div>
        </div>
      </a>
    </div>

    <!-- 官方故事库 -->
    <h2 class="sec">官方故事库 <a class="more" href="catalog.html">全部题材 →</a></h2>
    <div class="story-list" id="official-stories">
      <a class="story" data-cat="古风" href="catalog.html?g=guofeng">
        <div class="cov" style="background:linear-gradient(160deg,#B8863B,#8C5A2B)">🎭</div>
        <div class="body">
          <div class="t">《三国演义》· 吕布篇</div>
          <div class="s">穿越成吕布，改写三国命运</div>
          <div class="meta">
            <span>古风</span><span>5 转折</span><span>6 结局</span>
            <span class="star">★</span><span>4.8</span>
            <span class="play">开始 →</span>
          </div>
        </div>
      </a>
      <a class="story" data-cat="恋爱" href="catalog.html?g=haomen">
        <div class="cov" style="background:linear-gradient(160deg,#8E5BD8,#C95B9C)">🎭</div>
        <div class="body">
          <div class="t">《傲慢与偏见》· 达西篇</div>
          <div class="s">英伦豪门，重写你与达西的相遇</div>
          <div class="meta">
            <span>豪门</span><span>4 转折</span><span>5 结局</span>
            <span class="star">★</span><span>4.9</span>
            <span class="play">开始 →</span>
          </div>
        </div>
      </a>
      <a class="story" data-cat="悬疑" href="catalog.html?g=xuanyi">
        <div class="cov" style="background:linear-gradient(160deg,#2E5E56,#00B894)">🧛</div>
        <div class="body">
          <div class="t">《德古拉》</div>
          <div class="s">哥特暗夜，与吸血鬼共写命运</div>
          <div class="meta">
            <span>哥特</span><span>6 转折</span><span>7 结局</span>
            <span class="star">★</span><span>4.7</span>
            <span class="play">开始 →</span>
          </div>
        </div>
      </a>
    </div>

    <!-- 玩家创作 -->
    <h2 class="sec">玩家创作 <a class="more" href="discover.html">发现广场 →</a></h2>
    <div class="story-list">
      <a class="story" href="catalog.html?u=123">
        <div class="cov" style="background:linear-gradient(160deg,#3A2E5E,#6C5CE7)">🌌</div>
        <div class="body">
          <div class="t">《深海回声》by 林清雪</div>
          <div class="s">悬疑 · 8 转折 · 12 结局</div>
          <div class="meta">
            <span>悬疑</span><span>⭐ 4.8</span><span>2.3 万人游玩</span>
            <span class="play">开始 →</span>
          </div>
        </div>
      </a>
      <a class="story" href="catalog.html?u=456">
        <div class="cov" style="background:linear-gradient(160deg,#5A6B8E,#C95B9C)">⚡</div>
        <div class="body">
          <div class="t">《长夜未央》by 顾长夜</div>
          <div class="s">玄幻 · 7 转折 · 9 结局</div>
          <div class="meta">
            <span>玄幻</span><span>⭐ 4.6</span><span>1.1 万人游玩</span>
            <span class="play">开始 →</span>
          </div>
        </div>
      </a>
    </div>

    <!-- 完整版入口 -->
    <a class="more-link" href="library.html?full=1" onclick="showToast('warn','已是移动版','完整版桌面视图请用 PC 打开');return false;">
      📋 查看 30 题材完整对照表（即将开放）
    </a>
  </main>

  <!-- 5 Tab 底部（世界 active） -->
  <nav class="tabbar">
    <a class="tab" href="../product-preview.html"><span class="ico">🏠</span><span>首页</span></a>
    <a class="tab t-world active" href="library.html"><span class="ico">📖</span><span>世界</span></a>
    <a class="tab t-xinyu" href="heart-island.html"><span class="ico">💬</span><span>心屿</span></a>
    <a class="tab t-create" href="creator-center.html"><span class="ico">✨</span><span>创作</span></a>
    <a class="tab" href="me.html"><span class="ico">👤</span><span>我的</span></a>
  </nav>
</div>

<!-- Toast -->
<div id="toast"></div>

<script>
function showToast(kind, title, msg){
  var c = document.getElementById('toast');
  var t = document.createElement('div');
  t.className = 'toast-item ' + (kind || 'ok');
  t.innerHTML = '<span class="ti"></span><span><b>' + title + '</b>' + (msg ? '<span style="opacity:.65"> · ' + msg + '</span>' : '') + '</span>';
  c.appendChild(t);
  setTimeout(function(){ t.remove(); }, 3000);
}

// 分类筛选
document.querySelectorAll('#chips .chip').forEach(function(ch){
  ch.addEventListener('click', function(){
    document.querySelectorAll('#chips .chip').forEach(function(x){ x.classList.remove('active'); });
    ch.classList.add('active');
    var cat = ch.dataset.cat;
    document.querySelectorAll('#official-stories .story').forEach(function(s){
      s.style.display = (cat === 'all' || s.dataset.cat === cat) ? 'flex' : 'none';
    });
  });
});

// 搜索筛选
function filterStories(q){
  q = (q || '').toLowerCase();
  ['my-stories','official-stories'].forEach(function(group){
    document.querySelectorAll('#' + group + ' .story').forEach(function(s){
      var t = s.querySelector('.t').textContent.toLowerCase();
      s.style.display = (!q || t.indexOf(q) > -1) ? 'flex' : 'none';
    });
  });
}
</script>
</body>
</html>
