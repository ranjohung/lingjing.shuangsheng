<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>创作 · 灵境 · 双生</title>
<meta name="description" content="v6.4 · 第三卷·创世者手册 · 小说辅助 · 我的作品 · 上架定价 · 创作者法律" />
<meta name="theme-color" content="#1A1A2E" />
<link rel="stylesheet" href="css/shell-v64.css" />
<style>
/* ---------- 创作者等级卡 ---------- */
.level-card{
  margin:14px var(--margin);padding:16px;border-radius:16px;
  background:linear-gradient(135deg,rgba(255,179,71,.18),rgba(233,69,96,.10)),var(--card);
  border:1px solid rgba(255,179,71,.3);
}
.lc-row1{display:flex;align-items:center;gap:12px}
.lc-badge{
  width:54px;height:54px;border-radius:14px;flex-shrink:0;
  background:linear-gradient(135deg,var(--warn),#E89B5A);
  display:grid;place-items:center;font-size:24px;
  box-shadow:0 4px 14px rgba(255,179,71,.35);
}
.lc-meta{flex:1;min-width:0}
.lc-name{font-size:16px;font-weight:600}
.lc-level{font-size:11px;color:var(--warn);margin-top:2px;font-weight:500}
.lc-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.lc-stat{padding:10px;border-radius:10px;background:rgba(0,0,0,.2);border:1px solid var(--line)}
.lc-stat .v{font-size:18px;font-weight:600;font-family:-apple-system,BlinkMacSystemFont,serif}
.lc-stat .l{font-size:11px;color:var(--sub);margin-top:2px}
.lc-stat .v.c1{color:var(--warn)}
.lc-stat .v.c2{color:#A29BFE}
.lc-row3{display:flex;gap:8px;margin-top:12px}
.lc-btn{
  flex:1;height:40px;border-radius:10px;font-size:13px;font-weight:500;
  background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--text);
  display:flex;align-items:center;justify-content:center;gap:6px;
}
.lc-btn.primary{background:linear-gradient(135deg,var(--accent),#C73652);color:#fff;border-color:transparent}

/* ---------- 3 大功能区（快速入口） ---------- */
.func-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:10px;
  margin:0 var(--margin);
}
.func{
  padding:14px;border-radius:var(--radius);
  background:var(--card);border:1px solid var(--line);
  transition:transform .2s cubic-bezier(.16,1,.3,1);
  display:block;
}
.func:active{transform:scale(.97)}
.func .ico{
  width:36px;height:36px;border-radius:10px;
  display:grid;place-items:center;font-size:18px;
  margin-bottom:10px;
}
.func .t{font-size:14px;font-weight:600}
.func .s{font-size:11px;color:var(--sub);margin-top:3px;line-height:1.5}
.func .tags{display:flex;gap:4px;margin-top:8px;flex-wrap:wrap}
.func .tag{font-size:9px;padding:2px 6px;border-radius:4px;background:rgba(255,255,255,.06);color:var(--sub)}

/* ---------- 我的作品列表 ---------- */
.work-list{margin:0 var(--margin);display:flex;flex-direction:column;gap:10px}
.work{
  display:flex;gap:12px;align-items:center;padding:12px;border-radius:var(--radius);
  background:var(--card);border:1px solid var(--line);
}
.work .cov{
  width:50px;height:64px;border-radius:8px;flex-shrink:0;
  display:grid;place-items:center;font-size:22px;
}
.work .body{flex:1;min-width:0}
.work .t{font-size:15px;font-weight:600;line-height:1.3}
.work .s{font-size:12px;color:var(--sub);margin-top:3px}
.work .meta{display:flex;gap:8px;font-size:11px;color:rgba(160,160,176,.7);margin-top:5px;align-items:center}
.work .meta .star{color:var(--warn)}
.work .acts{display:flex;flex-direction:column;gap:5px;flex-shrink:0}
.work .acts .a{
  font-size:11px;padding:5px 10px;border-radius:7px;
  background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--text);text-align:center;
}
.work .acts .a.primary{background:rgba(255,179,71,.18);border-color:rgba(255,179,71,.4);color:var(--warn)}

/* ---------- 创作者法律快捷 ---------- */
.legal-card{
  margin:0 var(--margin);padding:14px;border-radius:var(--radius);
  background:linear-gradient(135deg,rgba(255,179,71,.10),rgba(233,69,96,.06));
  border:1px solid rgba(255,179,71,.25);
  display:flex;gap:12px;align-items:center;
}
.legal-card .ico{
  width:42px;height:42px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,var(--warn),#E89B5A);
  display:grid;place-items:center;font-size:20px;
}
.legal-card .t{font-size:14px;font-weight:600}
.legal-card .s{font-size:11px;color:var(--sub);margin-top:2px}
</style>
</head>
<body>

<div id="app">

  <!-- 顶栏（v6.4 共享壳） -->
  <header class="topbar">
    <div class="topbar-title"><span class="dot"></span>创作</div>
    <div class="topbar-acts">
      <button class="icon-btn" onclick="showToast('ok','数据已更新','3 个新订阅 · 1280 灵晶')" title="数据">📊</button>
      <a class="icon-btn" href="novel-ai-helper.html" title="AI 辅助">✨</a>
      <button class="icon-btn" onclick="showToast('warn','2 条审核通知','作品 #1234 已通过')">🔔<span class="badge">2</span></button>
      <a class="icon-btn" href="me.html" title="我的">👤</a>
    </div>
  </header>

  <main>
    <!-- 创作者等级 -->
    <section class="level-card">
      <div class="lc-row1">
        <div class="lc-badge">🏆</div>
        <div class="lc-meta">
          <div class="lc-name">L3 · 黄金创作者</div>
          <div class="lc-level">距 L4 钻石还差 1,200 灵晶收益</div>
        </div>
      </div>
      <div class="lc-row2">
        <div class="lc-stat"><div class="v c1">12,800</div><div class="l">总收益灵晶</div></div>
        <div class="lc-stat"><div class="v c2">3,200</div><div class="l">待结算</div></div>
      </div>
      <div class="lc-row3">
        <a class="lc-btn primary" href="commerce.html">💰 提现</a>
        <a class="lc-btn" href="commerce.html#earnings">📈 收益明细</a>
      </div>
    </section>

    <!-- 我的作品 -->
    <h2 class="sec">我的作品 <a class="more" href="novel-edit.html">全部</a></h2>
    <div class="work-list">
      <div class="work">
        <div class="cov" style="background:linear-gradient(160deg,#2E3A6E,#4A3A8C)">🏯</div>
        <div class="body">
          <div class="t">《长夜城》</div>
          <div class="s">已发布 · 12.8 万字 · 1.2 万游玩</div>
          <div class="meta"><span class="star">★</span><span>4.8</span><span>· 收益 8,400 灵晶</span></div>
        </div>
        <div class="acts">
          <a class="a primary" href="novel-edit.html?w=changye">编辑</a>
          <a class="a" href="commerce.html?w=changye">数据</a>
        </div>
      </div>
      <div class="work">
        <div class="cov" style="background:linear-gradient(160deg,#5E2E3A,#E94560)">🌸</div>
        <div class="body">
          <div class="t">《赛博长夜》</div>
          <div class="s">草稿 · 3.2 万字 · 未发布</div>
          <div class="meta"><span>最近编辑 1 小时前</span></div>
        </div>
        <div class="acts">
          <a class="a primary" href="novel-edit.html?w=saibo">继续</a>
          <a class="a" href="novel-upload.html?w=saibo">预览</a>
        </div>
      </div>
    </div>

    <!-- 3 大功能区 -->
    <h2 class="sec">3 大功能区 <a class="more" href="creator-center.html#all">查看全部</a></h2>
    <div class="func-grid">
      <a class="func" href="novel-ai-helper.html">
        <div class="ico" style="background:linear-gradient(135deg,rgba(255,179,71,.3),rgba(233,69,96,.2))">📝</div>
        <div class="t">小说辅助模拟器</div>
        <div class="s">28 字段模板 + 12 类提问 + 6 维自动检测</div>
        <div class="tags"><span class="tag">28 字段</span><span class="tag">12 提问</span></div>
      </a>
      <a class="func" href="novel-upload.html">
        <div class="ico" style="background:linear-gradient(135deg,rgba(78,204,163,.3),rgba(0,184,148,.2))">📤</div>
        <div class="t">上传即生成</div>
        <div class="s">TXT/MD/DOCX 上传 → 自动分章/抽角色/识场景</div>
        <div class="tags"><span class="tag">3 格式</span><span class="tag">99% 覆盖</span></div>
      </a>
      <a class="func" href="commerce.html">
        <div class="ico" style="background:linear-gradient(135deg,rgba(108,92,231,.3),rgba(155,91,224,.2))">💰</div>
        <div class="t">上架与定价</div>
        <div class="s">版权分层 L1-L4 + 22 收费点 + 5 档分成</div>
        <div class="tags"><span class="tag">L1-L4</span><span class="tag">22 点</span></div>
      </a>
      <a class="func" href="creator-create.html">
        <div class="ico" style="background:linear-gradient(135deg,rgba(233,69,96,.3),rgba(192,57,82,.2))">✨</div>
        <div class="t">创建新作品</div>
        <div class="s">3 步向导：选路径 → 基础信息 → 确认</div>
        <div class="tags"><span class="tag">3 步</span><span class="tag">快速</span></div>
      </a>
    </div>

    <!-- 创作者法律 -->
    <a class="legal-card" href="creator-legal.html">
      <div class="ico">📜</div>
      <div style="flex:1">
        <div class="t">创作者法律指南</div>
        <div class="s">13 份专属文书 · AI 创作版权 / 改编授权 / 收益分成</div>
      </div>
      <div style="font-size:18px;opacity:.5">›</div>
    </a>
  </main>

  <!-- 5 Tab 底部（创作 active） -->
  <nav class="tabbar">
    <a class="tab" href="../product-preview.html"><span class="ico">🏠</span><span>首页</span></a>
    <a class="tab t-world" href="library.html"><span class="ico">📖</span><span>世界</span></a>
    <a class="tab t-xinyu" href="heart-island.html"><span class="ico">💬</span><span>心屿</span></a>
    <a class="tab t-create active" href="creator-center.html"><span class="ico">✨</span><span>创作</span></a>
    <a class="tab" href="me.html"><span class="ico">👤</span><span>我的</span></a>
  </nav>
</div>

<div id="toast"></div>

<script>
function showToast(kind, title, msg){
  var c = document.getElementById('toast');
  var t = document.createElement('div');
  t.className = 'toast-item ' + (kind || 'ok');
  t.innerHTML = '<span class="ti"></span><span><b>' + title + '</b>' + (msg ? '<span style="opacity:.65"> · ' + msg + '</span>' : '') + '</span>';
  c.appendChild(t);
  setTimeout(function(){ t.remove(); }, 3000);
}
</script>
</body>
</html>
