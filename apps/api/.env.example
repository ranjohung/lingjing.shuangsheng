# Copy to .env.local for a local deployment and replace all production values.
ENVIRONMENT=production
AUTH_JWT_SECRET=replace-with-a-long-random-hs256-secret
DEV_AUTH_ENABLED=false
CORS_ORIGINS=https://ranjohung.github.io
# Current runtime adapters support SQLite; PostgreSQL adapter migration is a later gate.
STORY_DATABASE_URL=sqlite:///./story-development.db
# Optional frontend/API integrations:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# LJ_API_BASE=https://api.example.com
