# MIRAI / 灵境 环境变量样例
# 用法：复制为 .env.local（已被 .gitignore 忽略），按需填写
# 未填写的第三方 Key 不会导致启动失败，而是降级为本地/模拟模式

# === API ===
API_HOST=0.0.0.0
API_PORT=8000

# === PostgreSQL（本地 docker-compose 默认值）===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mirai
POSTGRES_PASSWORD=local_dev_pass
POSTGRES_DB=mirai
DATABASE_URL=postgresql://mirai:local_dev_pass@localhost:5432/mirai

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Supabase Auth（Phase 4 需要；未配置时后端使用本地 dev 用户）===
SUPABASE_URL=
SUPABASE_ANON_KEY=

# === LLM 模型 Gateway（Phase 9 需要；未配置时后端使用规则模拟回复）===
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# === Resend 邮件（Phase 13 需要）===
RESEND_API_KEY=

# === Stripe 订阅（Phase 14 需要）===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Sentry（可选）===
SENTRY_DSN=

# === 成本熔断器（Phase 0 必须存在）===
DAILY_BUDGET_LIMIT_USD=50
# 本地演示用：每次 /chat 计入的模拟成本（美元），用于演示熔断
DEMO_COST_PER_REQUEST_USD=0.01

# === 前端 ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Story persistence: opt in, then run alembic upgrade head. Leave unset for ephemeral development.
# STORY_DATABASE_URL=postgresql+psycopg://mirai:local_dev_pass@localhost:5432/mirai
